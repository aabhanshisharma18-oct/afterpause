# Copy to .env. Replace placeholders before connecting to MySQL.
APP_ENV=development
SECRET_KEY=replace_with_a_random_secret
# Use a shared Redis URL for production credential limits.
RATELIMIT_STORAGE_URI=memory://
DATABASE_URL=mysql+pymysql://afterpause:replace_db_password@127.0.0.1:3306/afterpause_dev?charset=utf8mb4
DEMO_DATABASE_URL=mysql+pymysql://afterpause:replace_db_password@127.0.0.1:3306/afterpause_demo?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://afterpause:replace_db_password@127.0.0.1:3306/afterpause_test?charset=utf8mb4
# Default storage lives under the ignored instance/ directory.
# UPLOAD_DIR=/path/to/persistent/uploads
# DEMO_UPLOAD_DIR=/path/to/separate/demo-uploads
# Optional Compose settings:
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password
MYSQL_PASSWORD=replace_db_password
MYSQL_PORT=3306
